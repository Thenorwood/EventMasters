@model EventMasters.Models.Concert

@{
    ViewData["Title"] = "Details";
}

<hi>Concert Information</hi>

<div>

</div>

<d1 class="row">

    <dt class="col-sm-2">
        @Html.DisplayNameFor(model => model.Title)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(model => model.Title)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(m => m.Description)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(m => m.Description)
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(m => m.Category)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(m => m.Category)
    </dd>

    <dt class="col-sm-10">
        @Html.DisplayNameFor(m =>m.Location)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(m => m.Location)
    </dd>

    <dt class="col-sm-10">
        @Html.DisplayNameFor(m => m.Owner)
    </dt>
    <dd class="col-sm-10">
        @Html.DisplayFor(m => m.Owner)
    </dd>
    

    <dt class="col-sm-2">
        @Html.DisplayNameFor(m => m.EventDate)
     </dt>

    <dd class="col-sm-10">
        @Model.EventDate.ToString("yyyy-MM-dd HH:mm")
    </dd>

    <dt class="col-sm-2">
        @Html.DisplayNameFor(m => m.DateAdded)
    </dt>

    <dd class="col-sm-10">
        @Model.DateAdded.ToString("yyyy-MM-dd")
    </dd>

</d1>

<div>
    <a asp-controller="Home" asp-action="Edit" asp-route-id="@Model?.ConcertId">"Edit"</a>
    <a asp-controller="Home" asp-action="Index">Back to List</a>
</div>
